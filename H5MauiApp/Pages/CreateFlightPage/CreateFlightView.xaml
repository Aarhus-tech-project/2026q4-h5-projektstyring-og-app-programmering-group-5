<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:H5MauiApp.Pages.CreateFlightPage"
    x:Class="H5MauiApp.Pages.CreateFlightPage.CreateFlightView"
    x:DataType="local:CreateFlightViewModel"
    Title="Create flight">

    <ContentPage.Resources>
        <DataTemplate
            x:Key="FlightTemplate"
            x:DataType="local:FlightOption">

            <Border
                Padding="12"
                Margin="16,6"
                Stroke="#CCCCCC"
                StrokeThickness="1">

                <VerticalStackLayout Spacing="8">
                    <Label
                        FontAttributes="Bold"
                        Text="{Binding FirstFlight.DepartureAirport.Name,
                            StringFormat='From: {0}'}" />

                    <Label
                        FontAttributes="Bold"
                        Text="{Binding LastFlight.ArrivalAirport.Name,
                            StringFormat='To: {0}'}" />

                    <Label Text="{Binding StopsDescription}" />

                    <BoxView
                        HeightRequest="1"
                        Color="#CCCCCC" />

                    <Label
                        FontAttributes="Bold"
                        Text="Flight segments" />

                    <VerticalStackLayout
                        Spacing="8"
                        BindableLayout.ItemsSource="{Binding Flights}">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:FlightSegment">
                                <Border
                                    Padding="10"
                                    Stroke="#DDDDDD"
                                    StrokeThickness="1">

                                    <VerticalStackLayout Spacing="4">
                                        <Label
                                            FontAttributes="Bold"
                                            Text="{Binding Airline}" />

                                        <Label
                                            Text="{Binding FlightNumber,
                                                StringFormat='Flight: {0}'}" />

                                        <Label
                                            Text="{Binding DepartureAirport.Name,
                                                StringFormat='From: {0}'}" />

                                        <Label
                                            Text="{Binding DepartureAirport.Id,
                                                StringFormat='Airport: {0}'}" />

                                        <Label
                                            Text="{Binding DepartureAirport.Time,
                                                StringFormat='Departure: {0}'}" />

                                        <Label
                                            Text="{Binding ArrivalAirport.Name,
                                                StringFormat='To: {0}'}" />

                                        <Label
                                            Text="{Binding ArrivalAirport.Id,
                                                StringFormat='Airport: {0}'}" />

                                        <Label
                                            Text="{Binding ArrivalAirport.Time,
                                                StringFormat='Arrival: {0}'}" />

                                        <Label
                                            Text="{Binding Duration,
                                                StringFormat='Flight: {0} min'}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger
                                TargetType="VerticalStackLayout"
                                Binding="{Binding Layovers.Count}"
                                Value="0">

                                <Setter
                                    Property="IsVisible"
                                    Value="False" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <Label
                            FontAttributes="Bold"
                            Text="Connections / layovers" />

                        <VerticalStackLayout
                            Spacing="8"
                            BindableLayout.ItemsSource="{Binding Layovers}">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:FlightLayover">
                                    <Border
                                        Padding="10"
                                        Stroke="#DDDDDD"
                                        StrokeThickness="1">

                                        <VerticalStackLayout Spacing="4">
                                            <Label
                                                FontAttributes="Bold"
                                                Text="{Binding Name}" />

                                            <Label
                                                Text="{Binding Id,
                                                    StringFormat='Airport: {0}'}" />

                                            <Label
                                                Text="{Binding Duration,
                                                    StringFormat='{0} min'}" />

                                            <Label
                                                IsVisible="{Binding Overnight}"
                                                Text="Overnight layover" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <BoxView
                        HeightRequest="1"
                        Color="#CCCCCC" />

                    <Label
                        Text="{Binding TotalDuration,
                            StringFormat='Total duration: {0} min'}" />

                    <Label
                        FontAttributes="Bold"
                        Text="{Binding Price,
                            StringFormat='Price: {0} DKK'}" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="8">
            <VerticalStackLayout
                Padding="16"
                Spacing="8">

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Departure country" />

                <Picker
                    Title="Select departure country"
                    ItemsSource="{Binding Countries}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding DepartureCountry, Mode=TwoWay}" />

                <Label
                    Margin="0,12,0,0"
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Destination country" />

                <Picker
                    Title="Select destination country"
                    ItemsSource="{Binding Countries}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding DestinationCountry, Mode=TwoWay}" />

                <Label
                    Margin="0,12,0,0"
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Departure date" />

                <DatePicker
                    Date="{Binding DepartureDate, Mode=TwoWay}"
                    Format="d" />

                <Label
                    Margin="0,12,0,0"
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Return date" />

                <DatePicker
                    Date="{Binding ReturnDate, Mode=TwoWay}"
                    Format="d" />

                <Button
                    Command="{Binding GetAirportsCommand}"
                    Text="Search flights" />
            </VerticalStackLayout>

            <Label
                Margin="16,0"
                FontAttributes="Bold"
                FontSize="18"
                Text="Departure flights" />

            <CollectionView
                HeightRequest="500"
                ItemsSource="{Binding BestFlights}"
                ItemTemplate="{StaticResource FlightTemplate}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedDepartureFlight, Mode=TwoWay}"
                VerticalScrollBarVisibility="Always">

                <CollectionView.EmptyView>
                    <Label
                        Padding="16"
                        Text="No flights found yet." />
                </CollectionView.EmptyView>
            </CollectionView>

            <Label
                Margin="16,0"
                FontAttributes="Bold"
                FontSize="18"
                Text="Return flights" />

            <CollectionView
                HeightRequest="500"
                ItemsSource="{Binding BestReturningFlights}"
                ItemTemplate="{StaticResource FlightTemplate}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedReturnFlight, Mode=TwoWay}"
                VerticalScrollBarVisibility="Always">

                <CollectionView.EmptyView>
                    <Label
                        Padding="16"
                        Text="Select a departure flight first." />
                </CollectionView.EmptyView>
            </CollectionView>

            <Button
                Margin="16"
                Command="{Binding ConfirmTripCommand}"
                Text="Confirm trip" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>