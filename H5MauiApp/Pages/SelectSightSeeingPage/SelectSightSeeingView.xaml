<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:H5MauiApp.Pages.SelectSightSeeingPage"
    xmlns:models="clr-namespace:H5MauiApp.ApiModels"
    x:Class="H5MauiApp.Pages.SelectSightSeeingPage.SelectSightSeeingView"
    x:DataType="local:SelectSightSeeingViewModel">

    <VerticalStackLayout Padding="16" Spacing="12">
        <Entry
            Placeholder="Country"
            Text="{Binding InputCountry, Mode=TwoWay}" />

        <Entry
            Placeholder="City"
            Text="{Binding InputCity, Mode=TwoWay}" />

        <Button
            Command="{Binding GetPointsOfInterrestForCityCommand}"
            Text="Find places" />

        <CollectionView
            HeightRequest="400"
            ItemsSource="{Binding Places}"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <Label Text="No places found." />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Place">
                    <VerticalStackLayout Padding="0,8">
                        <Label Text="{Binding Name}" />
                        <Label Text="{Binding AddressLine1}" />
                        <Label Text="{Binding AddressLine2}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button>

        </Button>

    </VerticalStackLayout>
</ContentPage>