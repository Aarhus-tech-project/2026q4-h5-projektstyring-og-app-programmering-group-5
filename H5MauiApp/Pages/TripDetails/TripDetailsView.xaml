<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:H5MauiApp.Pages.TripDetails"
    xmlns:models="clr-namespace:H5MauiApp.ApiModels"
    x:Class="H5MauiApp.Pages.TripDetails.TripDetailsView"
    x:DataType="local:TripDetailsViewModel">

    <ContentPage.Resources>
        <DataTemplate
            x:Key="FlightSegmentTemplate"
            x:DataType="models:Flight">

            <Border
                Padding="10"
                Stroke="#DDDDDD"
                StrokeThickness="1">

                <VerticalStackLayout Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        Text="{Binding Direction}" />

                    <Label
                        Text="{Binding Position,
                            StringFormat='Segment position: {0}'}" />

                    <Label FontAttributes="Bold">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding DepartureAirportCode}" />
                                <Span Text=" → " />
                                <Span Text="{Binding ArrivalAirportCode}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Text="{Binding Airline}" />

                    <Label
                        Text="{Binding FlightNumber,
                            StringFormat='Flight: {0}'}" />

                    <Label
                        Text="{Binding DepartureAirportName,
                            StringFormat='From: {0}'}" />

                    <Label
                        Text="{Binding DepartureLocalTime,
                            StringFormat='Departure: {0:dd/MM/yyyy HH:mm}'}" />

                    <Label
                        Text="{Binding ArrivalAirportName,
                            StringFormat='To: {0}'}" />

                    <Label
                        Text="{Binding ArrivalLocalTime,
                            StringFormat='Arrival: {0:dd/MM/yyyy HH:mm}'}" />

                    <Label
                        Text="{Binding Duration,
                            StringFormat='Flight time: {0} min'}" />

                    <Label
                        Text="{Binding Airplane,
                            StringFormat='Aircraft: {0}'}" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <CollectionView
        ItemsSource="{Binding Trip.TripEvents}"
        SelectionMode="None">

        <CollectionView.Header>
            <VerticalStackLayout
                Padding="16"
                Spacing="12">

                <Label
                    Text="{Binding Trip.Title}"
                    FontSize="24"
                    FontAttributes="Bold" />

                <Button
                    Text="Add flight"
                    Command="{Binding GoToCreateFlightPageCommand}" />

                <Button
                    Text="Add sight seeing spot"
                    Command="{Binding GoToSelectSightSeeingPageCommand}" />

                <Label
                    IsVisible="False"
                    Text="No flights selected yet.">

                    <Label.Triggers>
                        <DataTrigger
                            TargetType="Label"
                            Binding="{Binding Trip.FlightPlan}"
                            Value="{x:Null}">

                            <Setter
                                Property="IsVisible"
                                Value="True" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout.Triggers>
                        <DataTrigger
                            TargetType="VerticalStackLayout"
                            Binding="{Binding Trip.FlightPlan}"
                            Value="{x:Null}">

                            <Setter
                                Property="IsVisible"
                                Value="False" />
                        </DataTrigger>
                    </VerticalStackLayout.Triggers>

                    <Label FontAttributes="Bold">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Total price: " />

                                <Span
                                    Text="{Binding
                                        Trip.FlightPlan.TotalPrice,
                                        StringFormat='{0:N2}'}" />

                                <Span Text=" " />

                                <Span
                                    Text="{Binding
                                        Trip.FlightPlan.Currency}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label
                        Text="{Binding Trip.FlightPlan.OutboundDuration,
                            StringFormat='Outbound duration: {0} min'}" />

                    <Label
                        Text="{Binding Trip.FlightPlan.ReturnDuration,
                            StringFormat='Return duration: {0} min'}" />

                    <BoxView
                        HeightRequest="1"
                        Color="#CCCCCC" />

                    <HorizontalStackLayout Spacing="8">
                        <Label
                            Text="Flight segments"
                            FontSize="16"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />

                        <Switch x:Name="SegmentsSwitch" />
                    </HorizontalStackLayout>

                    <VerticalStackLayout
                        Spacing="8"
                        IsVisible="{Binding IsToggled,
                            Source={x:Reference SegmentsSwitch},
                            x:DataType=Switch}"
                        BindableLayout.ItemsSource="{Binding
                            Trip.FlightPlan.Flights}"
                        BindableLayout.ItemTemplate="{StaticResource
                            FlightSegmentTemplate}" />

                    <Label
                        FontSize="12"
                        Text="All flight times are local." />
                </VerticalStackLayout>

                <BoxView
                    HeightRequest="1"
                    Color="#CCCCCC" />

                <Label
                    Text="Trip events"
                    FontSize="16"
                    FontAttributes="Bold" />
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.EmptyView>
            <VerticalStackLayout Padding="16">
                <Label
                    Text="No trip events added yet"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:TripEvent">
                <VerticalStackLayout
                    Padding="16,8"
                    Spacing="4">

                    <Label
                        Text="{Binding Place.Name,
                            TargetNullValue='Unnamed place'}"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Label Text="{Binding Place.City}" />

                    <Label Text="{Binding Place.AddressLine1}" />

                    <Label Text="{Binding Place.AddressLine2}" />

                    <HorizontalStackLayout Spacing="8">
                        <Label
                            Text="{Binding Place.Lat,
                                StringFormat='Lat: {0:F4}'}"
                            FontSize="12" />

                        <Label
                            Text="{Binding Place.Lon,
                                StringFormat='Lon: {0:F4}'}"
                            FontSize="12" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>