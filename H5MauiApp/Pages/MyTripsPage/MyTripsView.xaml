<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:H5MauiApp.Pages.MyTripsPage"
    xmlns:models="clr-namespace:H5MauiApp.ApiModels"
    x:Class="H5MauiApp.Pages.MyTripsPage.MyTripsView"
    x:DataType="local:MyTripsViewModel">

    <CollectionView
        Margin="16"
        ItemsSource="{Binding Trips}"
        SelectionMode="None"
        EmptyView="You have no trips yet.">

        <CollectionView.Header>
            <VerticalStackLayout
                Padding="0,0,0,12"
                Spacing="12">

                <Label
                    Text="My trips"
                    FontSize="24"
                    FontAttributes="Bold" />

                <Button
                    Text="Create trip"
                    Command="{Binding ShowPopupCommand}" />
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Trip">
                <Border
                    Padding="12"
                    Margin="0,0,0,12"
                    Stroke="#CCCCCC"
                    StrokeThickness="1">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding GoToDetailedTripCommand,
                                Source={RelativeSource
                                    AncestorType=local:MyTripsViewModel},
                                x:DataType=local:MyTripsViewModel}"
                            CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>

                    <Label
                        Text="{Binding Title}"
                        FontSize="18"
                        FontAttributes="Bold" />
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>