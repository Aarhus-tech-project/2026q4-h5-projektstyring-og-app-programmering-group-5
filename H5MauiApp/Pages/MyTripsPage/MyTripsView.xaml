<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:H5MauiApp.Pages.MyTripsPage"
             xmlns:models="clr-namespace:H5MauiApp.ApiModels"
             x:Class="H5MauiApp.Pages.MyTripsPage.MyTripsView"
             x:DataType="local:MyTripsViewModel">
    <VerticalStackLayout Padding="16" Spacing="12">

        <Label
            Text="My trips"
            FontSize="24"
            FontAttributes="Bold" />

        <Button
            Text="Create trip"
            Command="{Binding ShowPopupCommand}" />

        <CollectionView
            ItemsSource="{Binding Trips}"
            HeightRequest="500"
            SelectionMode="None"
            EmptyView="You have no trips yet.">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Trip">
                    <VerticalStackLayout Padding="12">
                        <Label
                            Text="{Binding Title}"
                            FontSize="18" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>
</ContentPage>